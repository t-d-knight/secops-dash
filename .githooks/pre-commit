#!/bin/sh
# Blocks commits that add real organisation identifiers (internal domains,
# OUs, site codes, IPs, secrets) -- see tools/check_identifiers.py and
# CONTRIBUTING.md. Enable once per clone:
#   git config core.hooksPath .githooks
ROOT="$(git rev-parse --show-toplevel)"
PY="$ROOT/venv/bin/python3"
[ -x "$PY" ] || PY=python3
exec "$PY" "$ROOT/tools/check_identifiers.py"
