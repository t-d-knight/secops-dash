        "uid": "${DS_POSTGRESQL}"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT sender_domain AS \"Sender domain\", count(*) AS \"Events\", count(DISTINCT site_label) AS \"Sites hit\" FROM email_events WHERE site_label IN ($site) AND created_at >= '${__from:date}'::date AND created_at < '${__to:date}'::date + 1 AND sender_domain IS NOT NULL GROUP BY 1 ORDER BY 2 DESC LIMIT 15"
        }
