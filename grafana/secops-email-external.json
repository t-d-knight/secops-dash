      "title": "Recent High+ email events",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRESQL}"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Severity"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Critical": {
                        "color": "red",
                        "index": 0
                      },
                      "High": {
                        "color": "orange",
                        "index": 1
                      },
                      "Medium": {
                        "color": "dark-yellow",
                        "index": 2
                      },
                      "Low": {
                        "color": "yellow",
                        "index": 3
                      },
                      "critical": {
                        "color": "red",
                        "index": 4
                      },
                      "high": {
                        "color": "orange",
                        "index": 5
                      },
                      "medium": {
                        "color": "dark-yellow",
                        "index": 6
                      },
                      "low": {
                        "color": "yellow",
                        "index": 7
                      },
                      "info": {
                        "color": "blue",
                        "index": 8
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Link"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open",
                    "url": "${__value.raw}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT created_at AS \"Time\", event_type AS \"Type\", severity AS \"Severity\", state AS \"State\", site_label AS \"Site\", sender AS \"Sender\", recipient_domain AS \"Recipient domain\", action_taken AS \"Action\", link AS \"Link\" FROM email_events WHERE site_label IN ($site) AND severity IN ('critical','high') AND created_at >= '${__from:date}'::date AND created_at < '${__to:date}'::date + 1 ORDER BY created_at DESC LIMIT 200"
        }
      ]
    },
