# secrets.yaml.example
# Copy to secrets.yaml (gitignored -- never commit it) and chmod 600.
# Every section here is deep-merged over the same section in config.yaml;
# lists of named items (entra tenants) merge by `name`.

database:
  user: "secops_user"
  password: "ChangeMe123!"

# One Falcon API client with: Hosts, Host groups, Assets (Discover),
# Vulnerabilities, Alerts (read) + Identity Protection Entities (read) and
# Identity Protection GraphQL (write -- CrowdStrike's scope name for querying).
crowdstrike:
  client_id: "YOUR_FALCON_CLIENT_ID"
  client_secret: "YOUR_FALCON_CLIENT_SECRET"

collectors:
  hadrian:
    api_key: "YOUR_HADRIAN_API_KEY"

  checkpoint_hec:
    client_id: "YOUR_INFINITY_PORTAL_CLIENT_ID"
    access_key: "YOUR_INFINITY_PORTAL_ACCESS_KEY"

  entra:
    tenants:
      - name: "main"
        client_id: "APP_REGISTRATION_CLIENT_ID"
        client_secret: "APP_REGISTRATION_SECRET"

  dmarc:
    username: "dashboard_reader"
    password: "OPENSEARCH_PASSWORD"

# Report publishing to a file share (publish.py). Or leave these out and set
# SECOPS_SMB_USERNAME / SECOPS_SMB_PASSWORD in the cron job's environment.
publish:
  smb:
    username: "svc_secops_publish"
    password: "SHARE_ACCOUNT_PASSWORD"

# Optional. nvd_enrich.py works without it at NVD's public rate limit
# (5 requests/30s); a free key raises that to 50/30s.
nvd:
  api_key: "YOUR_NVD_API_KEY"
