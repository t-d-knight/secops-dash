# config.yaml.example
# Copy to config.yaml (gitignored -- it holds real site/domain names) and
# fill in. Credentials go in secrets.yaml (see secrets.yaml.example); any
# section there is deep-merged over the same section here.

crowdstrike:
  base_url: "https://api.us-2.crowdstrike.com"   # US-2 tenant
  # client_id / client_secret -> secrets.yaml

reporting:
  # exec_report.py also prints each report to PDF with headless Chromium
  # (dnf install chromium); set false for HTML only, or chromium_path if it
  # isn't on PATH.
  pdf: true
  # chromium_path: "/usr/bin/chromium-browser"
  # Days a vuln source mass-stamped findings as "first found" because
  # collection started or coverage expanded (not new vulns). The exec report
  # leaves them out of "opened" and won't compare snapshots across them.
  # vuln_bulk_load_dates: ["2026-01-15"]
  days_last_seen: 30
  # true  = only flag remote/no-auth vulns that also have a known exploit (lower noise, recommended)
  # false = flag every network-reachable, no-auth vuln
  require_exploit_for_remote_no_auth: true
  retention_days: 540            # daily_* snapshot tables
  findings_retention_days: 180   # FIXED/EXPIRED rows in vuln_findings
  events_retention_days: 365     # security_alerts, email_events, entra_risk_detections, dmarc_daily
  stale_sensor_days: 7           # a managed host not seen for this long counts as a stale sensor
  sla_days:
    critical: 2
    high: 14
    medium: 30
    low: 60

# ---------------------------------------------------------------------------
# Sites. Every collector resolves what it finds to one of these. Signals
# are tried in site_resolution.order; the first signal type that matches
# any site wins. Fill in whichever matchers are reliable for each site --
# not every site needs every matcher. Anything unmatched lands in
# ungrouped_label, and the "Site mapping gaps" dashboard panel shows what
# fell through and why, so tune this from real data.
# ---------------------------------------------------------------------------
site_resolution:
  order: [falcon_tags, falcon_groups, ou_contains, ad_sites, ad_domains, hostname_regex, cidrs, email_domains]

sites:
  - key: "SITE-A"
    label: "Site A"
    contacts: ["it-lead@site-a.example.org.au"]   # for the later per-site access phase
    match:
      falcon_tags: ["SensorGroupingTags/SiteA"]     # exact; the part after the last / also matches
      falcon_groups: ["Site A - Workstations", "Site A - Servers"]
      ou_contains: ["OU=Site A"]
      ad_sites: ["SiteA-Main"]
      ad_domains: ["sitea.local"]
      hostname_regex: ["^SA[-_]"]
      cidrs: ["10.10.0.0/16", "203.0.113.0/28"]      # include public ranges for Hadrian assets
      email_domains: ["site-a.example.org.au"]      # also matches subdomains; used by DMARC, HEC, Entra, Hadrian web assets
  - key: "SITE-B"
    label: "Site B"
    match:
      falcon_groups: ["Site B"]
      ad_domains: ["siteb.local"]
      email_domains: ["site-b.example.org.au"]

ungrouped_label: "Ungrouped"

# ---------------------------------------------------------------------------
# Collectors. Each is independent: enable what you have, and a failure in
# one never stops the others (see collector_runs / the freshness panel).
# ---------------------------------------------------------------------------
collectors:

  # Falcon host inventory + Exposure Management unmanaged assets.
  # Runs first; the other Falcon collectors reuse its site answer per host.
  falcon_hosts:
    enabled: true
    # OUs whose AD computer accounts are expected to have no sensor in THIS
    # Falcon tenant (a service on its own CID, or one that has left) -> Discover
    # class "out_of_scope", kept off every missing-sensor list. Exact OU segment
    # names, case-insensitive; the value is just a note for humans.
    # out_of_scope_ous:
    #   SITE-C: "runs its own Falcon CID"
    # filter: "last_seen:>='now-90d'"       # optional FQL
    include_unmanaged: true                 # needs the Assets (Discover) read scope
    # unmanaged_filter: "entity_type:'unmanaged'"

  # Falcon Exposure Management / Spotlight vulnerabilities -> vuln_findings
  falcon_spotlight:
    enabled: true
    page_size: 5000                        # CrowdStrike's documented max for this endpoint (confirmed 2026-10-05:
                                            # 10000 is rejected with "must be between 1 and 5000"); this pull is a
                                            # full open-vuln pull on every run, not just --full, so the page count
                                            # matters every night -- ~4x fewer round-trips for ~4x the data, with
                                            # roughly flat per-request latency (~5s regardless of 1000 vs 5000)
    closed_lookback_days: 30               # first run / --full window for closed vulns
    # filter: "host_info.platform_name:'Windows'"   # optional FQL ANDed onto every pull

  # Falcon alerts (endpoint + identity detections + anything else Falcon raises)
  falcon_alerts:
    enabled: true
    lookback_days: 30
    # filter: "product:['epp','idp']"

  # Falcon Identity Protection risk (stale, weak/compromised passwords, ...)
  falcon_identity:
    enabled: true
    entity_types: ["USER"]
    page_size: 1000
    # A shared domain other sites' staff also get accounts in just for VPN or
    # remote apps: those accounts are tagged vpn / rds / vpn+rds / legacy.
    # access_domain:
    #   domain: "shared.example.local"
    #   native_sites: ["SITE-C"]
    # OU segments of services that have left: their identities are kept but
    # marked out_of_scope, off the report categories and action packs.
    # out_of_scope_ous: ["SITE-C"]
    # What kind of account each identity is -- human / service / mailbox /
    # generic -- so e.g. "no MFA" can leave out service accounts and mailboxes,
    # and generic logons get their own list. Regexes, case-insensitive: `ou`
    # and `group` must match a WHOLE OU segment / AD group name ("Corporate
    # Services" is a department, "SITE-A Service Accounts" isn't); `name` is
    # searched within the account name. These override the defaults in
    # identity_categories.py (shown here); anything unmatched falls back to
    # Falcon's own MailboxRole / ProgrammaticUserAccountRole, else "human".
    # An Entra-only group (e.g. a cloud "generic accounts" group) needs the
    # entra collector; AD groups synced to Entra are seen here already.
    # account_kinds:
    #   mailbox: {ou: [".*shared mailboxes", "exchange resources", ".*meeting rooms", "resource bookings",
    #                  "generic mail accounts"]}
    #   service: {ou: [".*service accounts"], name: ["svc"]}
    #   generic: {ou: ["generic (users|accounts|logons)"], group: [".*generic.*"]}
    # query_file: "collectors/queries/identity_entities.graphql"

  # Hadrian Atlas (external attack surface). Schema confirmed against the
  # live API on 2026-10-06 -- see collectors/hadrian.py.
  hadrian:
    enabled: true
    mode: api                     # api | csv
    base_url: "https://api.hadrian.io"
    auth_header: "X-Api-Key"      # confirmed: the key goes in this header, not Authorization
    auth_scheme: ""                # bare key, no "Bearer" prefix
    organization_id: "YOUR_ORGANIZATION_ID"
    # api_key -> secrets.yaml
    # Asset tags in Hadrian are the site keys. Tags here are mapped first:
    tag_aliases: {OLD-SITE: SITE-A}   # a Hadrian tag for a site since merged into another
    archive_tags: ["zzArchive"]   # abandoned domains pending removal: asset + its risks skipped
    # Untagged assets whose site was inferred from their apex domain are
    # listed here -- tag them in Hadrian so its console agrees with us.
    suggested_tags_out: "reports/hadrian-suggested-tags.csv"
    detail_workers: 4             # parallel GET /risks/{id} (one per risk, for its asset)
    assets:
      path: "/organizations/{organization_id}/assets"
      items_key: "items"
      # offset here is a PAGE INDEX, not a row offset -- do not change `type`
      # to `offset`, that mode increments by row count and will silently
      # skip pages against this API. `page` mode increments by 1, which is
      # what Hadrian's pagination actually wants; start at 0, not 1.
      pagination: {type: page, param: offset, size_param: pageSize, size: 100, start: 0}
      fields: {id: assetId, name: value, type: platformAssetType,
               first_seen: detectedOnUtc, last_seen: lastSeenAtUtc}
      # ip and ports are NOT flat fields on this schema (ip only exists as
      # `value` on StaticIp/DynamicIp assets, or via services[].ipAsset;
      # ports come from services[].port) -- collectors/hadrian.py derives
      # both directly from the record instead of through this field map.
    risks:
      path: "/organizations/{organization_id}/risks"
      detail_path: "/organizations/{organization_id}/risks/{id}"
      items_key: "items"
      pagination: {type: page, param: offset, size_param: pageSize, size: 100, start: 0}
      full_pull: true             # every run returns all risks -> unseen ones are expired
      # activity (Open/Closed) is the lifecycle; status (New/Reopened/
      # Resolved/NotFound) refines it. Closed/NotFound = rescan no longer
      # sees it -> counted as fixed.
      fields: {id: id, title: title, severity: riskSeverity, activity: activityStatus,
               status: status, visibility: riskVisibility, risk_type: riskType,
               category: primaryCategory.id, first_seen: created, last_seen: lastSeen,
               resolved_at: resolvedOn}
    csv:
      assets_path: "data/hadrian/assets.csv"   # column names = the field map values above
      risks_path: "data/hadrian/risks.csv"

  # Check Point Harmony Email & Collaboration
  checkpoint_hec:
    enabled: true
    # The Authentication URL shown when you create the Infinity Portal API key.
    gateway: "https://cloudinfra-gw.portal.checkpoint.com"
    lookback_days: 14
    # event_types: ["phishing", "suspicious_phishing", "malware", "suspicious_malware", "dlp", "anomaly"]
    # client_id / access_key -> secrets.yaml

  # Check Point HEC mail-flow funnel (collectors/checkpoint_hec_flow.py):
  # daily counts of inbound mail through Microsoft (inbox/junk/quarantine) and
  # Check Point (clean/graymail/spam/phishing/malware, quarantined), per site
  # by recipient domain. Uses checkpoint_hec's credentials. Counts only -- no
  # email content is pulled.
  checkpoint_hec_flow:
    enabled: false
    lookback_days: 3      # days recomputed each run (verdicts/restores change after delivery)
    backfill_days: 14     # with collect.py --full
    workers: 4            # parallel count queries

  # Entra ID via Microsoft Graph. One app registration per tenant.
  entra:
    enabled: true
    feeds: [risky_users, risk_detections, mfa_registration]
    lookback_days: 30
    members_only: true
    tenants:
      - name: "main"
        tenant_id: "00000000-0000-0000-0000-000000000000"
        # client_id / client_secret -> secrets.yaml under collectors.entra.tenants, matched by name

  # Azure Log Analytics / Sentinel workspace rollups (KQL aggregated server-side).
  # Each query must return columns: day, key, dimension, value.
  azure_log_analytics:
    enabled: false
    lookback_days: 7
    # tenants: reuses collectors.entra.tenants unless set here
    workspaces:
      - name: "sentinel"
        tenant: "main"
        workspace_id: "00000000-0000-0000-0000-000000000000"
    queries:
      - name: signins
        key_type: upn
        kql: |
          SigninLogs
          | where TimeGenerated > ago({lookback_days}d)
          | summarize value = count() by day = startofday(TimeGenerated), key = UserPrincipalName,
              dimension = iff(ResultType == "0", "success", "failure")
      - name: legacy_auth
        key_type: upn
        kql: |
          SigninLogs
          | where TimeGenerated > ago({lookback_days}d)
          | where ClientAppUsed in ("Exchange ActiveSync", "IMAP4", "POP3", "Authenticated SMTP", "Other clients", "Exchange Web Services", "MAPI Over HTTP", "Offline Address Book", "Outlook Anywhere (RPC over HTTP)")
          | summarize value = count() by day = startofday(TimeGenerated), key = UserPrincipalName, dimension = ClientAppUsed
      - name: mfa_failures
        key_type: upn
        kql: |
          SigninLogs
          | where TimeGenerated > ago({lookback_days}d)
          | where ResultType == "500121"
          | summarize value = count() by day = startofday(TimeGenerated), key = UserPrincipalName, dimension = "mfa_denied"
      - name: risky_signins
        key_type: upn
        kql: |
          SigninLogs
          | where TimeGenerated > ago({lookback_days}d)
          | where RiskLevelDuringSignIn in ("medium", "high")
          | summarize value = count() by day = startofday(TimeGenerated), key = UserPrincipalName, dimension = RiskLevelDuringSignIn
      - name: ca_failures
        key_type: upn
        kql: |
          SigninLogs
          | where TimeGenerated > ago({lookback_days}d)
          | where ConditionalAccessStatus == "failure"
          | summarize value = count() by day = startofday(TimeGenerated), key = UserPrincipalName, dimension = "blocked"

  # DMARC aggregate data from parsedmarc's OpenSearch (cyber-dmarc)
  dmarc:
    enabled: true
    opensearch_url: "https://cyber-dmarc:9200"
    index: "dmarc_aggregate*"
    lookback_days: 10
    # ca_file: "/etc/pki/tls/certs/opensearch-ca.pem"    # or verify_tls: false for a self-signed lab box
    # username / password -> secrets.yaml

# Copy finished reports (weekly/quarterly exec reports, monthly action packs)
# to a file share, laid out <base>/<Site>/<Weekly|Quarterly|Monthly>/ -- e.g. a
# NAS that syncs into SharePoint. publish.py, run from cron after the reports.
# Credentials: publish.smb.username / password in secrets.yaml, or the
# SECOPS_SMB_USERNAME / SECOPS_SMB_PASSWORD environment variables.
publish:
  enabled: false
  method: smb                 # smb | local
  formats: ["pdf", "xlsx"]    # exec reports as PDF, action packs as Excel ("html" to also send the HTML)
  smb:
    server: "nas.example.local"
    share: "SecurityReports"
    base_path: ""             # folder inside the share; "" = share root
    # domain: "EXAMPLE"       # prefixed to the username if it has no domain part
    encrypt: true             # SMB3 encryption; set false only if the NAS can't
  # local:
  #   path: "/mnt/security-reports"

database:
  engine: "postgres"
  host: "127.0.0.1"
  port: 5432
  name: "secops_dashboard"
  # user / password -> secrets.yaml

grafana:
  url: "http://127.0.0.1:3000"

secrets_file: "secrets.yaml"
