# Local config (real site names, API client IDs) -- see config.yaml.example
/config.yaml
# Credentials -- see secrets.yaml.example
/secrets.yaml

# Rollback copies made when deploying (config.yaml.bak-20261013, secrets.yaml.bak-...,
# crontab.bak-...): may hold real config and credentials
*.bak
*.bak-*

# Other dev files
bld.txt
# Local notes (real names allowed), e.g. NEXT-STEPS.local.md
*.local.md
# Extra identifier denylist for tools/check_identifiers.py (real values)
/.identifiers.local

# Generated exec reports -- real site names and counts, not for git
/reports/*
# ...except the synthetic e2e-test previews, kept as committed examples
# (regenerate: python3 tests/demo_samples.py)
!/reports/sample-exec-report.html
!/reports/sample-exec-report-site.html
!/reports/sample-action-pack.xlsx

# Python
venv/
__pycache__/
*.pyc

# macOS
.DS_Store

# Database dumps (backup.sh)
/backups/

# Runtime logs (cron writes here; dir itself is tracked via .gitkeep)
/logs/*
!/logs/.gitkeep
/imports/
